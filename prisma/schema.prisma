datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  STUDENT
  ADMIN
}

enum PropertyType {
  PG
  FLAT
  CO_LIVING
}

enum GenderCategory {
  GIRLS
  BOYS
  CO_ED
}

enum SharingType {
  SINGLE
  DOUBLE
  TRIPLE
  FOUR_PLUS
}

enum PropertyLifecycle {
  DRAFT
  PENDING_REVIEW
  VERIFIED
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum FoodStatus {
  INCLUDED
  AVAILABLE
  NOT_AVAILABLE
}

enum ElectricityBillingType {
  INCLUDED
  BY_METER
  FIXED_MONTHLY
  EXTRA_AS_PER_USAGE
}

enum FurnishedStatus {
  FULLY_FURNISHED
  SEMI_FURNISHED
  UNFURNISHED
}

enum OwnerType {
  LANDLORD
  CARETAKER
  PROPERTY_MANAGER
  BROKER
  OTHER
}

enum AvailabilityStatus {
  AVAILABLE
  OCCUPIED
  COMING_SOON
  UNDER_MAINTENANCE
  PAUSED
}

enum VerificationStatus {
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
}

enum VisitStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                  String         @id @default(uuid())
  googleId            String?        @unique
  phone               String?        @unique
  fullName            String         @default("DU Student")
  personalEmail       String?
  collegeEmail        String?        @unique
  isCollegeVerified   Boolean        @default(false)
  collegeVerifiedAt   DateTime?
  collegeId           String?
  college             College?       @relation(fields: [collegeId], references: [id])
  studyYear           String?
  role                UserRole       @default(STUDENT)
  avatarUrl           String?
  budgetRange         String?
  gender              String?
  preferredLocations  String[]       @default([])
  notifyVisits        Boolean        @default(true)
  notifyMatches       Boolean        @default(true)
  notifyOffers        Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  visits              VisitBooking[]
  savedListings       SavedListing[]
  reviews             PropertyReview[]
  verificationTokens  EmailVerificationToken[]

  @@index([phone])
  @@index([collegeEmail])
  @@index([googleId])
}

model AdminUser {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  fullName            String
  phone               String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  permissions         AdminUserPermission[]
  assignedVisits      VisitBooking[]       @relation("CoordinatorVisits")
  verifiedProperties  Property[]           @relation("AdminVerifiedProperties")
  notificationDevices AdminNotificationDevice[]
  notifications       AdminNotification[]

  @@index([email])
}

model AdminPermission {
  id                  String               @id
  category            String
  description         String
  createdAt           DateTime             @default(now())

  users               AdminUserPermission[]
}

model AdminUserPermission {
  adminId             String
  admin               AdminUser            @relation(fields: [adminId], references: [id], onDelete: Cascade)
  permissionId        String
  permission          AdminPermission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([adminId, permissionId])
}

model College {
  id                  String               @id
  name                String               @unique
  shortCode           String
  campusZone          String
  area                String
  description         String
  imageUrl            String?
  latitude            Float?
  longitude           Float?
  createdAt           DateTime             @default(now())

  students            User[]
  approvedDomains     CollegeEmailDomain[]
  nearbyProperties    PropertyCollegeDistance[]
}

model CollegeEmailDomain {
  id                  String               @id @default(uuid())
  collegeId           String
  college             College              @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  domain              String               @unique
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())

  @@index([domain])
}

model Property {
  id                  String                    @id @default(uuid())
  propertyCode        String                    @unique
  slug                String                    @unique
  publicName          String
  type                PropertyType
  gender              GenderCategory
  localityZone        String
  area                String?
  
  // Pricing (monetary values as Decimal)
  rentMin             Int                       @default(0)
  rentMax             Int                       @default(0)
  depositAmount       Decimal                   @default(0) @db.Decimal(10, 2)
  singleRoomRent      Decimal?                  @db.Decimal(10, 2)
  doubleRoomRent      Decimal?                  @db.Decimal(10, 2)
  tripleRoomRent      Decimal?                  @db.Decimal(10, 2)

  // Food & Utilities
  food                FoodStatus?               @default(NOT_AVAILABLE)
  foodCharges         Decimal?                  @db.Decimal(10, 2)
  foodPolicy          String?                   @db.Text
  electricityCharges  Decimal?                  @db.Decimal(10, 2)
  electricityType     ElectricityBillingType?
  otherCharges        Decimal?                  @db.Decimal(10, 2)

  // Living, Units & Rules
  availableRooms      Int?                      @default(1)
  furnishedStatus     FurnishedStatus?          @default(FULLY_FURNISHED)
  amenities           String[]                  @default([])
  rules               String[]                  @default([])
  securityDetails     String?                   @db.Text

  // Location & Metrics
  distanceMin         Int                       @default(5)
  distanceText        String                    @default("Near DU Campus")
  description         String                    @db.Text
  isFeatured          Boolean                   @default(false)
  rating              Float                     @default(0)
  reviewCount         Int                       @default(0)

  // Verification
  isVerified          Boolean                   @default(false)
  verificationStatus  VerificationStatus        @default(PENDING)
  verificationNotes   String?                   @db.Text
  verifiedAt          DateTime?
  verifiedById        String?
  verifiedBy          AdminUser?                @relation("AdminVerifiedProperties", fields: [verifiedById], references: [id])
  verificationChecklist Json?

  // Availability & Lifecycle
  availabilityStatus  AvailabilityStatus        @default(AVAILABLE)
  lifecycleStatus     PropertyLifecycle         @default(DRAFT)

  // Internal Confidential Information (Admin Only)
  internalPropertyName String?
  exactAddress        String
  latitude            Float?
  longitude           Float?
  ownerName           String?
  ownerPhone          String?
  ownerAlternatePhone String?
  ownerType           OwnerType?                @default(LANDLORD)
  photoDriveLink      String?
  internalSource      String?
  internalAdminNotes  String?                   @db.Text
  
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  rooms               RoomInventory[]
  media               PropertyMedia[]
  reviews             PropertyReview[]
  savedIn             SavedListing[]
  visits              VisitBooking[]
  collegeDistances    PropertyCollegeDistance[]

  @@index([localityZone])
  @@index([area])
  @@index([type])
  @@index([gender])
  @@index([availabilityStatus])
  @@index([verificationStatus])
  @@index([lifecycleStatus])
  @@index([propertyCode])
}

model RoomInventory {
  id                  String               @id @default(uuid())
  propertyId          String
  property            Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  label               String
  sharingType         SharingType
  occupancyText       String
  rent                Int
  deposit             Int
  totalUnits          Int                  @default(1)
  availableUnits      Int                  @default(1)
  createdAt           DateTime             @default(now())

  @@index([propertyId])
}

model PropertyMedia {
  id                  String               @id @default(uuid())
  propertyId          String
  property            Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  mediaUrl            String
  mediaType           String               @default("image")
  displayOrder        Int                  @default(0)
  isPrimary           Boolean              @default(false)
  storageProvider     String               @default("LOCAL")
  storageKey          String?
  altText             String?
  width               Int?
  height              Int?
  fileSize            Int?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @default(now()) @updatedAt

  @@index([propertyId])
  @@index([propertyId, displayOrder])
  @@index([storageProvider])
}

model PropertyCollegeDistance {
  id                  String               @id @default(uuid())
  propertyId          String
  property            Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  collegeId           String
  college             College              @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  distanceMinutes     Int
  walkingDistanceM    Int?

  @@unique([propertyId, collegeId])
}

model PropertyReview {
  id                  String               @id @default(uuid())
  propertyId          String
  property            Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId              String
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating              Int
  reviewText          String               @db.Text
  status              ReviewStatus         @default(APPROVED)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([propertyId, userId])
  @@index([propertyId])
  @@index([userId])
  @@index([status])
  @@index([propertyId, status])
}

model SavedListing {
  id                  String               @id @default(uuid())
  userId              String
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId          String
  property            Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt           DateTime             @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
}

model VisitBooking {
  id                  String               @id @default(uuid())
  bookingCode         String               @unique
  userId              String
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId          String
  property            Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  visitDate           DateTime
  timeSlot            String
  visitorCount        Int                  @default(1)
  studentName         String
  studentPhone        String
  notes               String?              @db.Text
  status              VisitStatus          @default(PENDING)
  cancellationReason  String?
  coordinatorId       String?
  coordinator         AdminUser?           @relation("CoordinatorVisits", fields: [coordinatorId], references: [id])
  coordinatorNotes    String?              @db.Text
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([userId])
  @@index([propertyId])
  @@index([status])
  @@index([visitDate])
}

model EmailVerificationToken {
  id                  String               @id @default(uuid())
  userId              String
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  email               String
  tokenHash           String               @unique
  expiresAt           DateTime
  createdAt           DateTime             @default(now())

  @@index([tokenHash])
  @@index([userId])
}

model AuditLog {
  id                  String               @id @default(uuid())
  actorId             String
  actorType           String               @default("ADMIN")
  action              String
  targetEntity        String
  targetId            String
  details             Json?
  createdAt           DateTime             @default(now())
}

model AdminNotificationDevice {
  id                  String               @id @default(uuid())
  adminId             String
  admin               AdminUser            @relation(fields: [adminId], references: [id], onDelete: Cascade)
  token               String               @unique
  deviceLabel         String?
  userAgent           String?
  isActive            Boolean              @default(true)
  lastSeenAt          DateTime             @default(now())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([adminId])
  @@index([token])
}

model AdminNotification {
  id                  String               @id @default(uuid())
  adminId             String
  admin               AdminUser            @relation(fields: [adminId], references: [id], onDelete: Cascade)
  type                String               @default("NEW_VISIT")
  title               String
  body                String
  visitId             String?
  isRead              Boolean              @default(false)
  readAt              DateTime?
  createdAt           DateTime             @default(now())

  @@index([adminId])
  @@index([isRead])
  @@index([createdAt])
}

